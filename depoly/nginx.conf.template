# Install on the host HTTPS proxy. These upstreams are published on loopback only.
# The certificate must cover every listed name, including *.@HTTP_DOMAIN@.
server {
    listen 80;
    server_name @SITE_HOST@ @TERMINAL_HOST@ @ADMIN_HOST@ @BOT_HOST@ @GATEWAY_HOST@ *.@HTTP_DOMAIN@;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name @SITE_HOST@ @TERMINAL_HOST@ @ADMIN_HOST@;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @PRIVATE_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:@WEB_PORT@;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
    }
}
server {
    listen 443 ssl;
    server_name @BOT_HOST@;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @PRIVATE_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:@BOT_PORT@;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 180s;
    }
}
server {
    listen 443 ssl;
    server_name @GATEWAY_HOST@ *.@HTTP_DOMAIN@;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @PRIVATE_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:@GATEWAY_PORT@;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_request_buffering off;
    }
}
