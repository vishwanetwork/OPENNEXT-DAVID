# Cloud resource API keys, not model inference API keys.
LAMBDA_API_KEY=
TENSORDOCK_API_KEY=
# Optional read-only Console Droplet pricing token.
DIGITALOCEAN_API_KEY=
VULTR_API_KEY=
SHADEFORM_API_KEY=

# TensorDock is disabled pending registration. Add tensordock to restore it.
SPOTBOT_ENABLED_PROVIDERS=lambda,vultr,shadeform

# Scheduler and gateway requests use Authorization: Bearer <this value>.
# Leave empty only for local development. Live orders require a service key.
SPOTBOT_API_KEY=
SPOTBOT_LIVE_ORDERS_ENABLED=false
# Orders default to live (dry_run=false); the live switch still gates purchases.
# Set false to reject explicit dry_run=true requests as well.
SPOTBOT_DRY_RUN_ENABLED=true

# AWS is optional; add aws to SPOTBOT_ENABLED_PROVIDERS after configuring it.
# Use an EC2 instance role, or standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# (and AWS_SESSION_TOKEN for temporary credentials) in the process environment.
SPOTBOT_AWS_REGIONS=us-west-2
# Operator-enrolled fulfillment accounts; see docs/aws-account-fulfillment.md.
SPOTBOT_AWS_ACCOUNTS={}
# New OpenNext purchases: '*' for all; 'default', 'b300-west', or comma-separated aliases.
# Configure the OpenNext API process; retain all Bot accounts for existing lifetimes.
SPOTBOT_OPENNEXT_AWS_ACCOUNTS=*
# Optional inference is disabled until immutable model/image pins and hardware validation exist.
# Generate the 7B test entry with scripts/prepare_inference_preset.py; see docs/model-inference-provisioning.md.
SPOTBOT_INFERENCE_PRESETS={}
# Price references only (no orders): current Spot, list prices and history for more Regions.
SPOTBOT_AWS_PRICE_REGIONS=
# Optional separate AWS SDK profile for read-only current Spot references. Set both fields.
# Do not change AWS_PROFILE when existing orders/backups belong to the server's account.
SPOTBOT_AWS_PRICE_PROFILE=
SPOTBOT_AWS_REFERENCE_REGIONS=
SPOTBOT_AWS_PRICE_REGION_INTERVAL_SECONDS=3600
# Empty VPC selects the region's default VPC. Subnets are selected by offer AZ.
SPOTBOT_AWS_VPC_ID=
# Empty group list discovers the dedicated spotbot-gpu group in that VPC.
SPOTBOT_AWS_SECURITY_GROUP_IDS=
SPOTBOT_AWS_KEY_NAME=
# Empty image selects the official Ubuntu NVIDIA OSS driver AMI via SSM.
SPOTBOT_AWS_IMAGE_ID=
# The adapter increases this minimum to satisfy the image's root disk size.
SPOTBOT_AWS_ROOT_VOLUME_GB=30
SPOTBOT_AWS_PUBLIC_IP=true
SPOTBOT_AWS_SSH_USER=ubuntu
# Pause launch attempts after known quota/capacity rejection; prices remain visible.
SPOTBOT_AWS_CAPACITY_BACKOFF_SECONDS=60
# Published On-demand/Reserved rates from the AWS Price List; requires pricing:GetProducts.
SPOTBOT_AWS_LIST_PRICES_ENABLED=true
SPOTBOT_AWS_LIST_PRICE_INTERVAL_SECONDS=21600
# Backfill vendor Spot changes independently of current executable quotes.
SPOTBOT_AWS_SPOT_HISTORY_ENABLED=true
SPOTBOT_AWS_SPOT_HISTORY_INTERVAL_SECONDS=86400
SPOTBOT_AWS_LIST_HISTORY_ENABLED=true
SPOTBOT_AWS_LIST_HISTORY_INTERVAL_SECONDS=86400
SPOTBOT_DATABASE_PATH=data/spotbot.sqlite3
# Storage: sqlite (default), mysql, or dynamodb. Switching does not migrate data.
SPOTBOT_STORAGE_BACKEND=sqlite
SPOTBOT_MYSQL_URL=
SPOTBOT_DYNAMODB_TABLE=SpotOrderBot
SPOTBOT_DYNAMODB_REGION=us-east-1
# Leave the endpoint empty for AWS; set it only for DynamoDB Local.
SPOTBOT_DYNAMODB_ENDPOINT_URL=
# Keep false with a pre-provisioned production table; true permits creation.
SPOTBOT_DYNAMODB_CREATE_TABLE=false
SPOTBOT_BACKGROUND_ENABLED=true
SPOTBOT_COLLECT_INTERVAL_SECONDS=300
# Thin old price snapshots (MySQL/SQLite): all for 3 days, hourly to 30, daily to 90. See docs/storage.md.
SPOTBOT_PRICE_RETENTION_ENABLED=false
SPOTBOT_PRICE_RETENTION_RAW_DAYS=3
SPOTBOT_PRICE_RETENTION_HOURLY_DAYS=30
SPOTBOT_PRICE_RETENTION_DAILY_DAYS=90
SPOTBOT_WORKER_INTERVAL_SECONDS=15
SPOTBOT_PRICE_MAX_AGE_SECONDS=600
SPOTBOT_HTTP_TIMEOUT_SECONDS=30

# TensorDock estimates include one GPU plus this CPU, RAM, and storage profile.
SPOTBOT_TENSORDOCK_VCPUS=4
SPOTBOT_TENSORDOCK_RAM_GB=8
SPOTBOT_TENSORDOCK_STORAGE_GB=100

# Fixed gateway callback URL. The persistent outbox retries failed deliveries.
# Leave empty to retrieve handoff records through the API only.
SPOTBOT_GATEWAY_WEBHOOK_URL=
SPOTBOT_GATEWAY_WEBHOOK_SECRET=

# RFQ-driven protected rentals (AWS Linux/EBS only). Enable after deploying recovery IAM permissions.
SPOTBOT_RENTALS_ENABLED=false
# Separate from legacy ordering and pricing Regions; enroll recovery-ready Regions only.
SPOTBOT_RENTAL_REGIONS=us-west-2
# Region -> enrolled, account-owned encrypted base AMI used when an RFQ names none.
# Keeps the first rental backup incremental instead of a full copy of a public AMI.
SPOTBOT_RENTAL_INITIAL_IMAGES={}
# Reachable by GPU guests over HTTPS; no cloud credentials are passed to guests.
SPOTBOT_RENTAL_PUBLIC_URL=
# JSON map of tenant IDs to unique execution tokens (at least 32 characters each).
# These are upstream service credentials, never browser/client credentials.
SPOTBOT_RENTAL_TENANT_TOKENS={}
# Base64 of 32 random bytes sealing managed-task secrets; without it, tasks with secrets are refused.
SPOTBOT_RENTAL_TASK_KEY=
# Existing OpenNEXT API that `spotbot opennext-api` passes non-SpotOrderBot /api routes to.
SPOTBOT_OPENNEXT_LEGACY_ORIGIN=
# Read-only shared legacy account and marketplace snapshots for the Operations Console.
SPOTBOT_OPENNEXT_LEGACY_DATA_DIR=
# Independent base64-encoded 32-byte key for encrypted provider credentials; retain across restarts.
SPOTBOT_OPENNEXT_CONSOLE_KEY=
SPOTBOT_OPENNEXT_BOT_URL=
SPOTBOT_OPENNEXT_TENANT=opennext
SPOTBOT_OPENNEXT_GATEWAY_URL=
SPOTBOT_OPENNEXT_GATEWAY_TOKEN=
# Order notices by email through the OpenNEXT API's SMTP account; empty host sends none.
# Port 465 or SECURE=true is implicit TLS; otherwise STARTTLS is required.
SPOTBOT_OPENNEXT_SMTP_HOST=
SPOTBOT_OPENNEXT_SMTP_PORT=587
SPOTBOT_OPENNEXT_SMTP_SECURE=false
SPOTBOT_OPENNEXT_SMTP_USER=
SPOTBOT_OPENNEXT_SMTP_PASSWORD=
SPOTBOT_OPENNEXT_SMTP_FROM=
# The Terminal's public origin for links in notices.
SPOTBOT_OPENNEXT_PUBLIC_URL=
# Buyer KYB documents: a private persistent directory, an AES-256-GCM key (base64 of 32 bytes)
# and a ClamAV daemon (host:port). Uploads are refused without the key or the scanner.
SPOTBOT_OPENNEXT_FILES_DIR=data/opennext-kyb
SPOTBOT_OPENNEXT_FILES_KEY=
SPOTBOT_OPENNEXT_CLAMD=
SPOTBOT_OPENNEXT_ALLOW_UNSCANNED=false
SPOTBOT_OPENNEXT_KYB_RETENTION_DAYS=365
# Dedicated gateway-to-bot credential, at least 32 characters and distinct from all other tokens.
# Allows delivery state/connection reads and positive gateway acknowledgement only.
SPOTBOT_RENTAL_GATEWAY_TOKEN=
# JSON map of enabled order Regions to EventBridge-fed SQS queue URLs. Configure a DLQ.
SPOTBOT_RENTAL_INTERRUPTION_QUEUES={}
SPOTBOT_RENTAL_WORKER_SECONDS=5
# Pools (instance type x zone) tried per acquisition attempt before waiting retry_seconds.
SPOTBOT_RENTAL_POOLS_PER_ATTEMPT=8
SPOTBOT_RENTAL_BOOT_TIMEOUT_SECONDS=1200
# Unacknowledged gateway handoffs move to ACTION_REQUIRED after this many seconds.
SPOTBOT_RENTAL_DELIVERY_TIMEOUT_SECONDS=600
# Conservative budgeting rate per provisioned GiB-month; not an AWS price quote.
SPOTBOT_RENTAL_STORAGE_RESERVE_USD_GIB_MONTH=0.15

# SF Compute produces CLI plans only. Local sf login manages its credentials.

# Initial retail Spot markup in basis points; saved Console policy takes precedence.
SPOTBOT_OPENNEXT_SPOT_MARKUP_BPS=2000

# Enable only after deploying the matching quote/consent, settlement worker and gateway code.
# Historical duration-v1 purchases are never migrated or repriced.
SPOTBOT_FLOATING_ENABLED=false
SPOTBOT_FLOATING_WORKER_SECONDS=30
SPOTBOT_FLOATING_GRANT_SECONDS=120
