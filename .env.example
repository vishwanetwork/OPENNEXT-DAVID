# Cloud resource API keys, not model inference API keys.
LAMBDA_API_KEY=
TENSORDOCK_API_KEY=
VULTR_API_KEY=
SHADEFORM_API_KEY=

# TensorDock is disabled pending registration. Add tensordock to restore it.
SPOTBOT_ENABLED_PROVIDERS=lambda,vultr,shadeform

# Scheduler and gateway requests use Authorization: Bearer <this value>.
# Leave empty only for local development. Live orders require a service key.
SPOTBOT_API_KEY=
SPOTBOT_LIVE_ORDERS_ENABLED=false
# Orders default to live (dry_run=false); the live switch still gates purchases.
# Set false to reject explicit dry_run=true requests as well.
SPOTBOT_DRY_RUN_ENABLED=true

# AWS is optional; add aws to SPOTBOT_ENABLED_PROVIDERS after configuring it.
# Use an EC2 instance role, or standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# (and AWS_SESSION_TOKEN for temporary credentials) in the process environment.
SPOTBOT_AWS_REGIONS=us-west-2
# Empty VPC selects the region's default VPC. Subnets are selected by offer AZ.
SPOTBOT_AWS_VPC_ID=
# Empty group list discovers the dedicated spotbot-gpu group in that VPC.
SPOTBOT_AWS_SECURITY_GROUP_IDS=
SPOTBOT_AWS_KEY_NAME=
# Empty image selects the official Ubuntu NVIDIA OSS driver AMI via SSM.
SPOTBOT_AWS_IMAGE_ID=
# The adapter increases this minimum to satisfy the image's root disk size.
SPOTBOT_AWS_ROOT_VOLUME_GB=30
SPOTBOT_AWS_PUBLIC_IP=true
SPOTBOT_AWS_SSH_USER=ubuntu
# Pause launch attempts after known quota/capacity rejection; prices remain visible.
SPOTBOT_AWS_CAPACITY_BACKOFF_SECONDS=60
# Published On-demand/Reserved rates from the AWS Price List; requires pricing:GetProducts.
SPOTBOT_AWS_LIST_PRICES_ENABLED=true
SPOTBOT_AWS_LIST_PRICE_INTERVAL_SECONDS=21600
# Backfill vendor Spot changes independently of current executable quotes.
SPOTBOT_AWS_SPOT_HISTORY_ENABLED=true
SPOTBOT_AWS_SPOT_HISTORY_INTERVAL_SECONDS=86400
SPOTBOT_DATABASE_PATH=data/spotbot.sqlite3
# Storage: sqlite (default), mysql, or dynamodb. Switching does not migrate data.
SPOTBOT_STORAGE_BACKEND=sqlite
SPOTBOT_MYSQL_URL=
SPOTBOT_DYNAMODB_TABLE=SpotOrderBot
SPOTBOT_DYNAMODB_REGION=us-east-1
# Leave the endpoint empty for AWS; set it only for DynamoDB Local.
SPOTBOT_DYNAMODB_ENDPOINT_URL=
# Keep false with a pre-provisioned production table; true permits creation.
SPOTBOT_DYNAMODB_CREATE_TABLE=false
SPOTBOT_BACKGROUND_ENABLED=true
SPOTBOT_COLLECT_INTERVAL_SECONDS=300
SPOTBOT_WORKER_INTERVAL_SECONDS=15
SPOTBOT_PRICE_MAX_AGE_SECONDS=600
SPOTBOT_HTTP_TIMEOUT_SECONDS=30

# TensorDock estimates include one GPU plus this CPU, RAM, and storage profile.
SPOTBOT_TENSORDOCK_VCPUS=4
SPOTBOT_TENSORDOCK_RAM_GB=8
SPOTBOT_TENSORDOCK_STORAGE_GB=100

# Fixed gateway callback URL. The persistent outbox retries failed deliveries.
# Leave empty to retrieve handoff records through the API only.
SPOTBOT_GATEWAY_WEBHOOK_URL=
SPOTBOT_GATEWAY_WEBHOOK_SECRET=

# SF Compute produces CLI plans only. Local sf login manages its credentials.
