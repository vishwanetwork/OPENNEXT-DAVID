# Copy values into your server environment / secret manager. This file contains no keys.
OPENNEXT_PRICING_DATA_DIR=.opennext-data
OPENNEXT_AWS_REGIONS=us-east-1,us-east-2,us-west-2,eu-west-1,eu-central-1,ap-northeast-1,ap-southeast-1,ap-south-1
# Set a strong random token (at least 24 characters) before remote Console API access.
OPENNEXT_ADMIN_TOKEN=
# Enable only behind a trusted HTTPS reverse proxy with network-isolated upstream.
OPENNEXT_TRUST_PROXY=0
# Public AWS On-demand works without credentials. Spot is off until IAM + optional SDK is configured.
OPENNEXT_AWS_SPOT_ENABLED=0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LAMBDA_API_KEY=
SHADEFORM_API_KEY=
VULTR_API_KEY=

# Read-only chart bridge. Never expose this token to browser JavaScript.
OPENNEXT_SPOTBOT_URL=https://spotbot.test.vishwalab.com
OPENNEXT_SPOTBOT_API_KEY=
OPENNEXT_CAPACITY_REGIONS=us-west-2,us-east-1
OPENNEXT_AZURE_REGIONS=eastus,westus2

# Verified customer sessions and marketplace records require durable private storage.
OPENNEXT_DATA_DIR=.opennext-data
# Optional strong signing secret; otherwise a private key is generated in OPENNEXT_DATA_DIR.
OPENNEXT_AUTH_SESSION_SECRET=
# Trusted installer callbacks require a random secret of at least 32 characters.
OPENNEXT_AGENT_CALLBACK_TOKEN=
# Google / GitHub sign-in. A provider is enabled only when both its id and secret are set.
# Redirect URIs to register: https://terminal.opennextlab.ai/api/auth/oauth/{google|github}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# RFQ notification email to operations, sent in the background over SMTP after each submission.
# Port 587 requires STARTTLS; port 465 (or SMTP_SECURE=1) uses implicit TLS. Disabled until
# SMTP_HOST, SMTP_FROM and OPENNEXT_RFQ_NOTIFY_TO are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenNEXT <noreply@opennextlab.ai>
# Comma-separated operations recipients.
OPENNEXT_RFQ_NOTIFY_TO=
OPENNEXT_ADMIN_URL=https://admin.opennextlab.ai/
# Email verification, checkout and agent installers are server adapters.
# Leave adapters unconfigured until the backend is ready; no browser bypass exists.

# Read-only reference cards in Terminal; never seed customer orders or inventory.
OPENNEXT_REFERENCE_CATALOG_ENABLED=1

# Official GPU-market headlines are collected hourly by the running backend.
OPENNEXT_NEWS_ENABLED=1

# ---- Front-end (apps/web) ----
# Production binds one host per application; leave all three empty locally to serve
# /, /terminal and /admin from one origin.
SITE_HOST=
TERMINAL_HOST=
ADMIN_HOST=
# Backend origin the Next server proxies /api/* to (the legacy API in local development).
API_ORIGIN=http://127.0.0.1:4189
