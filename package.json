{
  "name": "opennext-monorepo",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:api": "PORT=4189 pnpm --filter opennext-legacy-api start",
    "build": "pnpm -r --filter './apps/**' --filter './packages/**' build",
    "lint": "pnpm -r --filter './apps/**' --filter './packages/**' lint",
    "typecheck": "pnpm -r --filter './apps/**' --filter './packages/**' typecheck",
    "test": "pnpm -r --filter './apps/**' --filter './packages/**' test",
    "test:legacy": "pnpm --filter opennext-legacy-api test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,md}\" \"packages/**/*.{ts,tsx,md}\" \"docs/**/*.md\"",
    "dev:web": "pnpm --filter @opennext/web dev"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
