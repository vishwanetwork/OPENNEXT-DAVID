# Independent gateway process. No provider keys or AWS credentials belong here.
SPOTBOT_GATEWAY_BOT_URL=https://spotbot.example.com
# Must match the bot's SPOTBOT_RENTAL_GATEWAY_TOKEN, not its administrator API key.
# Allows delivery reads and positive acknowledgements only; cannot procure, recover,
# reject handoffs, or release servers.
SPOTBOT_GATEWAY_BOT_TOKEN=
# A different random secret of at least 32 characters for the trusted upstream API.
SPOTBOT_GATEWAY_API_KEY=
# A separate random secret of at least 32 characters. Customer HTTP access tokens
# are derived from it; rotating it changes every rental's HTTP token, not the API key.
SPOTBOT_GATEWAY_HTTP_TOKEN_SECRET=
# Must match SPOTBOT_GATEWAY_WEBHOOK_SECRET in the bot environment.
SPOTBOT_GATEWAY_WEBHOOK_SECRET=
SPOTBOT_GATEWAY_PUBLIC_SSH_HOST=ssh.example.com
SPOTBOT_GATEWAY_PUBLIC_HTTP_DOMAIN=gpu.example.com
SPOTBOT_GATEWAY_SSH_BIND=0.0.0.0
SPOTBOT_GATEWAY_SSH_PORT_START=22000
SPOTBOT_GATEWAY_SSH_PORT_END=22999
# A closed rental's port can serve a new rental after this quarantine (default 7 days).
SPOTBOT_GATEWAY_SSH_PORT_REUSE_AFTER_SECONDS=604800
SPOTBOT_GATEWAY_POLL_SECONDS=5
SPOTBOT_GATEWAY_ROUTE_LEASE_SECONDS=60
# How long a model endpoint request may wait for the GPU server (30-1800 seconds).
SPOTBOT_GATEWAY_INFERENCE_READ_TIMEOUT_SECONDS=600
# Empty permits global unicast IPs only. Use explicit CIDRs for private networking.
SPOTBOT_GATEWAY_ALLOWED_TARGET_CIDRS=
SPOTBOT_GATEWAY_STORAGE_BACKEND=sqlite
SPOTBOT_GATEWAY_DATABASE_PATH=/app/gateway-data/gateway.sqlite3
# Use a separate MySQL database or DynamoDB table from the bot.
SPOTBOT_GATEWAY_MYSQL_URL=
SPOTBOT_GATEWAY_DYNAMODB_TABLE=SpotOrderGateway
SPOTBOT_GATEWAY_DYNAMODB_REGION=us-west-2
SPOTBOT_GATEWAY_DYNAMODB_ENDPOINT_URL=
SPOTBOT_GATEWAY_DYNAMODB_CREATE_TABLE=false
