# Operator-side staging tool. Do not deploy these SSH credentials on the gateway.
SPOTBOT_ACCEPTANCE_BOT_URL=https://spotbot.example.com
SPOTBOT_ACCEPTANCE_GATEWAY_URL=https://gateway.example.com
SPOTBOT_ACCEPTANCE_BOT_TOKEN=
SPOTBOT_ACCEPTANCE_GATEWAY_TOKEN=
SPOTBOT_ACCEPTANCE_TENANT_ID=staging
SPOTBOT_ACCEPTANCE_SSH_KEY_PATH=/secure/customer-key.pem
SPOTBOT_ACCEPTANCE_KNOWN_HOSTS_PATH=/secure/spotbot-staging-known-hosts
# Explicit staging option only. accept-new never accepts a changed host key.
SPOTBOT_ACCEPTANCE_TRUST_NEW_HOST_KEYS=false
SPOTBOT_ACCEPTANCE_STAGE_TIMEOUT_SECONDS=1200
SPOTBOT_ACCEPTANCE_CLEANUP_TIMEOUT_SECONDS=1200
SPOTBOT_ACCEPTANCE_POLL_SECONDS=5
